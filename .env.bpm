# BPM 平台对应的VUE页面
NODE_ENV=production
VUE_APP_PERMISSION=default
VUE_APP_PREVIEW=true

# BPM平台-组织机构运维服务地址
VUE_APP_SYSTEM_URL=/diit-system
# BPM平台-工作流运维服务地址
VUE_APP_WORKFLOW_URL=/diit-workflow
# BPM平台-表单设计器服务地址(若不涉及不用调整，预留)
VUE_APP_FORM_URL=/diit-form
# 移动管理服务地址(若不涉及不用调整，预留)
VUE_APP_MOBILE_URL=/diit-mobile
# 业务系统项目访问地址，需要根据实际情况调整
VUE_APP_PROJECT_URL=/diit-project
# VUE本项目访问地址(固定值，不能修改)
VUE_APP_APPLICATION_URL=/diit-operation-web
# 项目编译生成的文件夹名称
VUE_APP_OUTPUT_DIR=diit-operation-web
#单点登录
VUE_APP_SSO_URL=/sso